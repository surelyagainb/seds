APP_NAME="Victoria Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=victoria_db
DB_USERNAME=root
DB_PASSWORD=@dmin_123

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Gmail SMTP settings for login and registration OTP.
# 1) Turn on 2-Step Verification in the Google account, 2) create an App Password (myaccount.google.com/apppasswords),
# 3) paste the 16 characters below. Put the value in quotes if you keep the spaces Google shows.
# After changing anything here run:  php artisan config:clear   and test with:  php artisan mail:test
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD="your-16-character-app-password"
MAIL_FROM_ADDRESS=your-gmail@gmail.com
MAIL_FROM_NAME="${APP_NAME}"
# Optional: seconds to wait for Gmail before giving up
MAIL_TIMEOUT=20
# Optional, local testing only: set to false if PHP cannot verify Gmail's certificate (common on Windows)
MAIL_VERIFY_PEER=true
# The email of the seeded administrator. Use an inbox you can open, because login codes are sent there.
ADMIN_EMAIL=your-admin-gmail@gmail.com

ADMIN_BRAND=folio
